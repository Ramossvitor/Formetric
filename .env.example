# Local development database. Copy this file to .env before starting Compose.
# These credentials are intentionally development-only and must not be reused in production.
FORMETRIC_DB_NAME=formetric
FORMETRIC_DB_USER=formetric
FORMETRIC_DB_PASSWORD=formetric_dev_only
FORMETRIC_DB_PORT=5432

# Optional one-time owner bootstrap. Keep real values only in the ignored .env file
# or in your local shell; never commit them.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=Formetric Owner
SESSION_COOKIE_SECURE=false
