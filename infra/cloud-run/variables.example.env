# Public identifiers only. Copy to an ignored `.env.local` file or configure these names
# as GitHub Environment variables; never put secret values here.
GCP_PROJECT_ID=
GCP_REGION=southamerica-east1
CLOUD_RUN_SERVICE=formetric
ARTIFACT_REGISTRY_REPOSITORY=formetric
CLOUD_RUN_RUNTIME_SERVICE_ACCOUNT=
GCP_WORKLOAD_IDENTITY_PROVIDER=
GCP_DEPLOY_SERVICE_ACCOUNT=

# Secret Manager resource names and the pinned version used by a revision.
DB_POOLER_URL_SECRET=formetric-db-pooler-url
DB_DIRECT_URL_SECRET=formetric-db-direct-url
DB_USERNAME_SECRET=formetric-db-username
DB_PASSWORD_SECRET=formetric-db-password
DB_SECRET_VERSION=1

# Temporary bootstrap secrets. All three are required only for the private
# bootstrap revision and are explicitly removed by the normal candidate deploy.
BOOTSTRAP_ADMIN_EMAIL_SECRET=formetric-bootstrap-admin-email
BOOTSTRAP_ADMIN_PASSWORD_SECRET=formetric-bootstrap-admin-password
BOOTSTRAP_ADMIN_DISPLAY_NAME_SECRET=formetric-bootstrap-admin-display-name
BOOTSTRAP_SECRET_VERSION=1
